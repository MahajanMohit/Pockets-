<?xml version="1.0" encoding="utf-8"?>
<!--
  Flat "AI" lettering in single dark grey on pure black.
  No gradients, no highlights, no effects.
  A: two parallelogram legs + crossbar. I: solid rectangle.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Pure black background -->
    <path
        android:fillColor="#000000"
        android:pathData="M0,0 L108,0 L108,108 L0,108 Z" />

    <!-- Letter A — left leg -->
    <path
        android:fillColor="#3D3D3D"
        android:pathData="M38,22 L46,22 L32,82 L24,82 Z" />

    <!-- Letter A — right leg -->
    <path
        android:fillColor="#3D3D3D"
        android:pathData="M46,22 L54,22 L68,82 L60,82 Z" />

    <!-- Letter A — crossbar -->
    <path
        android:fillColor="#3D3D3D"
        android:pathData="M29,58 L59,58 L59,66 L29,66 Z" />

    <!-- Letter I -->
    <path
        android:fillColor="#3D3D3D"
        android:pathData="M75,22 L84,22 L84,82 L75,82 Z" />

</vector>
